# Copy to `.env` (gitignored) and fill in. Only EXPO_PUBLIC_* values reach the app bundle —
# never put secrets here. The Claude/Anthropic key lives in Supabase secrets (see README).

# Supabase project (Settings → API). Only needed when EXPO_PUBLIC_DATA_MODE=supabase.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# mock (default, seed data, no backend) | supabase (real tables + RLS)
EXPO_PUBLIC_DATA_MODE=mock

# Optional. mock (canned preview answers, default) | edge (Supabase Edge Function `oracle`)
EXPO_PUBLIC_ORACLE_MODE=mock

# Optional, development builds in supabase mode only. Fill both to skip the sign-in screen: at launch the app signs
# in as this account, creating it the first time. Leave either empty to sign in by hand. Release builds ignore them.
# The account is real on whichever project the URL points at, so use a test address (and a password of 8+ chars).
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=
